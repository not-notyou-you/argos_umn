# URL publik website. Satu-satunya nilai aplikasi yang berubah saat pindah domain.
PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=postgres://argos:change-me@localhost:5432/argos_umn
MEDIA_DIR=./data/media

# Password awal akun seeder, minimal 12 karakter. Wajib diganti saat login pertama.
SEED_PRESIDENT_PASSWORD=
SEED_VICE_PRESIDENT_PASSWORD=
SEED_SECRETARY_1_PASSWORD=
SEED_SECRETARY_2_PASSWORD=

# Docker Compose
POSTGRES_PASSWORD=
# Kunci enkripsi backup. Simpan terpisah dari server: tanpa ini backup tidak bisa dipulihkan.
BACKUP_PASSPHRASE=
TUNNEL_TOKEN=

# Header rahasia dari Worker. Kosongkan pada Fase A, wajib pada Quick Tunnel.
ORIGIN_SHARED_SECRET=
